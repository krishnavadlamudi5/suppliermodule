# Copy to backend/.env for local development, or set these in your hosting platform.
# backend/.env is git-ignored — never commit real credentials.

# Required
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net"

# Optional
MONGODB_DB="supplier_portal"
API_PORT=8787                 # local port (hosts that set PORT use that in production)
# NODE_ENV=production         # set by most hosts; enables production behaviour

# Strongly recommended before hosting publicly: password-protect the portal
# BASIC_AUTH_USER=dct
# BASIC_AUTH_PASSWORD=choose-a-long-random-password

# Hosting option A — one service serves both the API and the app (simplest, same origin):
# SERVE_FRONTEND_DIR=../frontend/dist

# Hosting option B — frontend hosted separately: allow its origin(s), comma-separated
# CORS_ORIGIN=https://suppliers.example.com
