{
  "name": "supplier-portal-backend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Supplier ESG portal API (Express + MongoDB)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "db:reset": "node -e \"fetch('http://127.0.0.1:8787/api/reset',{method:'POST'}).then(r=>r.json()).then(console.log)\""
  },
  "dependencies": {
    "express": "^5.3.0",
    "mongodb": "^7.9.1",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "typescript": "~7.0.2"
  }
}
