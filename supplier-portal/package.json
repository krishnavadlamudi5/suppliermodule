{
  "name": "supplier-portal",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "tokens": "node scripts/build-tokens.ts",
    "predev": "npm run tokens",
    "dev": "concurrently -n api,web -c green,blue \"npm:server\" \"npm:web\"",
    "web": "vite",
    "dev:mock": "npm run tokens && vite --mode mock",
    "server": "tsx watch server/index.ts",
    "db:reset": "node -e \"fetch('http://127.0.0.1:8787/api/reset',{method:'POST'}).then(r=>r.json()).then(console.log)\"",
    "prebuild": "npm run tokens",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@fontsource/montserrat": "^5.3.0",
    "antd": "^6.7.2",
    "express": "^5.3.0",
    "mongodb": "^7.9.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.1",
    "concurrently": "^10.0.7",
    "oxlint": "^1.90.0",
    "sass": "^1.108.2",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.1"
  }
}
